    "Run Linux and macOS side by side with your Mac apps. Creating virtual machines arrives in version 0.2 — this preview sets up your library.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Linux und macOS direkt neben deinen Mac-Apps. Virtuelle Maschinen erstellen kommt mit Version 0.2 – diese Vorschau richtet deine Bibliothek ein."
          }
        }
      }
    },
    "Select a virtual machine": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine virtuelle Maschine"
