    },
    "Created with a newer NestSuite (format %lld, this version reads %lld). Update NestSuite to open it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einer neueren NestSuite-Version erstellt (Format %1$lld, diese Version liest %2$lld). Aktualisiere NestSuite, um sie zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Created with a newer NestSuite (format %1$lld, this version reads %2$lld). Update NestSuite to open it."
          }
        }
      }
    },
