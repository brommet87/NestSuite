{
  "sourceLanguage": "en",
  "strings": {
    "A virtual machine with this name already exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bereits eine virtuelle Maschine mit diesem Namen."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über"
          }
        }
      }
    },
