      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbar"
          }
        }
      }
    },
    "Choose between %@ and %@ of memory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zwischen %1$@ und %2$@ Arbeitsspeicher."
          }
