        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Choose between %1$@ and %2$@ of memory."
          }
        }
      }
    },
    "Choose between %lld and %lld processors.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle zwischen %1$lld und %2$lld Prozessoren."
