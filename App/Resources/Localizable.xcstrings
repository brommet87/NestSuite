        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bibliotheksordner konnte nicht erstellt werden."
          }
        }
      }
    },
    "The settings file (config.json) is missing from this virtual machine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser virtuellen Maschine fehlt die Einstellungsdatei (config.json)."
          }
        }
      }
    },
    "The settings file is damaged and can’t be read. Details: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungsdatei ist beschädigt und kann nicht gelesen werden. Details: %@"
