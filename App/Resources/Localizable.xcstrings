{
  "sourceLanguage": "en",
  "strings": {
    "%lld virtual machine(s) are running. NestSuite asks each one to shut down before quitting.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Eine virtuelle Maschine läuft. NestSuite bittet sie vor dem Beenden herunterzufahren."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld virtuelle Maschinen laufen. NestSuite bittet jede vor dem Beenden herunterzufahren."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One virtual machine is running. NestSuite asks it to shut down before quitting."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld virtual machines are running. NestSuite asks each one to shut down before quitting."
                }
              }
            }
          }
        }
      }
    },
    "A virtual machine with this name already exists.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt bereits eine virtuelle Maschine mit diesem Namen."
          }
        }
      }
    },
    "About": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über"
          }
        }
      }
    },
    "Any ARM64 (aarch64) installer image.": {
      "localizations": {
        "de": {
