            "state": "translated",
            "value": "Ein beliebiges ARM64-Installationsimage (aarch64)."
          }
        }
      }
    },
    "Ask the operating system to shut down": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Betriebssystem bitten, herunterzufahren"
